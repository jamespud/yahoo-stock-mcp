# MySQL（外部数据库，通过连接串配置；不随 MCP server 内置）
# 所有变量带 YAHOO_STOCK_MCP_ 前缀，避免与 shell 里其他项目同名变量冲突。
# 优先使用 YAHOO_STOCK_MCP_DATABASE_URL，未设置时回退到下面的 DB_* 离散变量
YAHOO_STOCK_MCP_DATABASE_URL=mysql://stock:stock123@127.0.0.1:3306/yahoo_stock_mcp
YAHOO_STOCK_MCP_DB_HOST=127.0.0.1
YAHOO_STOCK_MCP_DB_PORT=3306
YAHOO_STOCK_MCP_DB_USER=stock
YAHOO_STOCK_MCP_DB_PASSWORD=stock123
YAHOO_STOCK_MCP_DB_NAME=yahoo_stock_mcp

# Providers
YAHOO_STOCK_MCP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36
YAHOO_STOCK_MCP_REQUEST_DELAY_MS=300
# 可选：所有 Node fetch 请求走 HTTP(S) 代理（Yahoo 在大陆需代理）
YAHOO_STOCK_MCP_PROXY_URL=http://127.0.0.1:17890

# Sync defaults
YAHOO_STOCK_MCP_BARS_START_DATE=2000-01-01
# 主数据源：两家都有时以谁为准（另一家只在主源缺数据时补位）。yahoo | investing
YAHOO_STOCK_MCP_PRIMARY_PROVIDER=yahoo
YAHOO_STOCK_MCP_NEWS_COUNT=20
