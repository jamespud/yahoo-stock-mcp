# The published package ships the compiled dist/ only.
# dist/ is intentionally NOT ignored here, so this file overrides the
# .gitignore rules that would otherwise keep it out of the npm tarball.

# Dev-only source, tests, and infrastructure:
src/
scripts/
deploy/
.cache/
.env
*.tsbuildinfo

# Python runtime bytecode and local environments are never distributable artifacts.
**/__pycache__/
**/*.pyc
quant/.venv/
quant/.pytest_cache/
quant/.hypothesis/
