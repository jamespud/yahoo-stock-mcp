{
  "name": "yahoo-stock-mcp",
  "version": "0.3.1",
  "description": "MCP server for stock information with unofficial Yahoo Finance + Investing.com integrations, backed by MySQL",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "yahoo-stock-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "db",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamespud/yahoo-stock-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stock",
    "yahoo-finance",
    "investing",
    "mysql"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "server": "node dist/cli.js server",
    "dev": "tsx src/cli.ts server",
    "db:init": "tsx src/cli.ts db:init",
    "sync": "tsx src/cli.ts sync",
    "smoke": "tsx scripts/smoke.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "test": "npm run test:cli && npm run test:providers && npm run test:transport && npm run test:indicators && npm run test:db && npm run test:mcp",
    "test:indicators": "tsx scripts/test-indicators.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test:cli": "tsx scripts/test-cli.ts",
    "test:providers": "tsx scripts/test-providers.ts",
    "test:transport": "tsx scripts/test-investing-transport.ts",
    "gen:fixtures": "tsx scripts/gen-indicator-fixtures.ts",
    "db:migrate": "tsx src/cli.ts db:migrate",
    "test:db-bootstrap": "tsx scripts/test-db-bootstrap.ts",
    "canary:providers": "tsx scripts/provider-canary.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "mysql2": "^3.11.0",
    "undici": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "technicalindicators": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
